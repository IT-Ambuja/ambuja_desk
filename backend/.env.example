# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql+pg8000://USER:PASSWORD@localhost:5432/ambuja_desk2

OUTLOOK_EMAIL=
OUTLOOK_PASSWORD=
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587

# Used to build the "View Ticket in Dashboard" link in notification emails
FRONTEND_URL=https://issuetracker.ambujaneotia.com

# Guards /api/token/file/<filename> (AssetInfinity CSV/file pulls). Generate with:
#   python -c "import uuid; print(str(uuid.uuid4()).upper())"
API_SECURE_TOKEN=

# Extra browser origins allowed to call /api (comma-separated).
# Not needed in production -- nginx serves the app from the same origin.
# Defaults to the Vite dev server: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=
