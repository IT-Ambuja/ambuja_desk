# Copy to .env before running `npm run build`. Never commit .env.
#
# WARNING: Vite inlines VITE_* values into the built JS bundle, which is served
# publicly. These are kept out of git, but they are NOT secret at runtime —
# anyone can read VITE_API_SECURE_TOKEN out of the bundle in devtools.
# The durable fix is for the backend to mint short-lived signed URLs at export
# time instead of the frontend embedding a shared static token.

# Origin used to build attachment links inside exported CSV/Excel reports
VITE_FILE_BASE_URL=https://issuetracker.ambujaneotia.com

# Must match API_SECURE_TOKEN in backend/.env
VITE_API_SECURE_TOKEN=
